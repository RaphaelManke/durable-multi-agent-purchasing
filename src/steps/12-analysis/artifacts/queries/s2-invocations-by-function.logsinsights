# Log group: aws/spans (CloudWatch Transaction Search). Traces: step 07 6ae5cbc4..., step 08 6ae5cc3b..., step 10 6ae5cca5..., step 11 6ae5cd1c...
# Stage 1 groups by spanId: Transaction Search can hold two records of one span (OTel span and X-Ray segment copy), and dedup cannot precede stats.
# Context propagation: how many invocations of which function ended up in each trace? One LambdaExecutionEnvironment span per invocation.
filter traceId in ["6ae5cbc4712cf6fd1703fd806783e1ad", "6ae5cc3b44cc9da909fe2c2e7aebf8f3", "6ae5cca544a55195411c3a0251cd3b9a", "6ae5cd1c75705e4c04ad9fe673a2a55e"] and kind = "SERVER" and name like /\/LambdaExecutionEnvironment$/
| parse name /^(?<fn>[^\/]+)\/LambdaExecutionEnvironment$/
| stats max(durationNano) as d by traceId, spanId, fn
| stats count() as invocations, sum(d) / 1000000 as totalMs by traceId, fn
| sort traceId asc, totalMs desc
