# Log group: aws/spans (CloudWatch Transaction Search). Traces: step 07 6ae5cbc4..., step 08 6ae5cc3b..., step 10 6ae5cca5..., step 11 6ae5cd1c...
# Stage 1 groups by spanId: Transaction Search can hold two records of one span (OTel span and X-Ray segment copy), and dedup cannot precede stats.
# Model calls seen as spans (GenAI semantic conventions): calls, tokens and latency per trace and model.
filter traceId in ["6ae5cbc4712cf6fd1703fd806783e1ad", "6ae5cc3b44cc9da909fe2c2e7aebf8f3", "6ae5cca544a55195411c3a0251cd3b9a", "6ae5cd1c75705e4c04ad9fe673a2a55e"] and attributes.rpc.service = "BedrockRuntime"
| stats latest(attributes.gen_ai.request.model) as model, max(attributes.gen_ai.usage.input_tokens) as inTok, max(attributes.gen_ai.usage.output_tokens) as outTok, max(durationNano) as d by traceId, spanId
| stats count() as calls, sum(inTok) as inputTokens, sum(outTok) as outputTokens, avg(d) / 1000000 as avgMs, max(d) / 1000000 as maxMs by traceId, model
| sort traceId asc
